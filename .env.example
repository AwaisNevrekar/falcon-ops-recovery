# Copy to .env and fill ONE provider. The system must also work with no key (rule-based fallbacks).
GROQ_API_KEY=
# GEMINI_API_KEY=
# FALCON_LLM=ollama          (local Ollama; also: off = force rule fallbacks)
# FALCON_LLM_MODEL=          (override the default model)
# FALCON_GUARD=ollama        (optional second opinion for the injection filter: llama-guard3 via Ollama)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
